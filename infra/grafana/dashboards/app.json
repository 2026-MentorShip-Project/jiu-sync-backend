{
  "uid": "jiu-sync-app",
  "title": "Jiu-Sync / App",
  "tags": [
    "jiu-sync",
    "app"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by view",
      "description": "django-prometheus,不含 Alloy scrape(view=\"metrics\")。",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (view) (rate(django_http_requests_total_by_view_transport_method_total{view!=\"metrics\"}[$__rate_interval]))",
          "legendFormat": "{{view}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "4xx / 5xx ratio",
      "description": "佔全部回應(不含 /metrics)的比例;無流量時無資料。虛線 = 5xx 告警門檻 5%(D10)。",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_view_method_total{view!=\"metrics\", status=~\"4..\"}[$__rate_interval])) / sum(rate(django_http_responses_total_by_status_view_method_total{view!=\"metrics\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(django_http_responses_total_by_status_view_method_total{view!=\"metrics\", status=~\"5..\"}[$__rate_interval])) / sum(rate(django_http_responses_total_by_status_view_method_total{view!=\"metrics\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 by view",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, view) (rate(django_http_requests_latency_seconds_by_view_method_bucket{view!=\"metrics\"}[$__rate_interval])))",
          "legendFormat": "{{view}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95 by view",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, view) (rate(django_http_requests_latency_seconds_by_view_method_bucket{view!=\"metrics\"}[$__rate_interval])))",
          "legendFormat": "{{view}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI restaurant recommendation latency p95",
      "description": "events:restaurant-recommendations(呼叫 AI)。req/s 用右軸。",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{view=\"events:restaurant-recommendations\", view!=\"metrics\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total{view=\"events:restaurant-recommendations\", view!=\"metrics\"}[$__rate_interval]))",
          "legendFormat": "req/s",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "B"
        }
      ]
    }
  ]
}
